        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome true\nskinparam shadowing false\nskinparam linetype ortho\n\ntitle Matkatoimisto Vamos - Tietomalli (UML 2.0 Luokkakaavio)\n\nenum KayttajaRooli {\n  ASIAKAS\n  YLLAPITAJA\n}\n\nenum VarauksenTila {\n  KASITTELYSSA\n  VAHVISTETTU\n  MAKSETTU_KOKONAAN\n  PERUTTU\n}\n\nenum MaksunTyyppi {\n  VARAUSMAKSU\n  LOPPUSUORITUS\n}\n\nenum MaksunTila {\n  ODOTTAA\n  HYVAKSYTTY\n  HYLATTY\n}\n\nclass Kayttaja &lt;&lt;Entity&gt;&gt; {\n  - kayttajaId : UUID &lt;&lt;PK&gt;&gt;\n  - sahkoposti : String {unique, encrypted}\n  - salasanaTiiviste : String\n  - rooli : KayttajaRooli\n  - luontiAika : DateTime\n  + tarkistaOikeus(rooli : KayttajaRooli) : Boolean\n}\n\nclass Asiakas &lt;&lt;Entity&gt;&gt; {\n  - asiakasId : UUID &lt;&lt;PK&gt;&gt;\n  - kayttajaId : UUID &lt;&lt;FK&gt;&gt;\n  - etunimi : String {encrypted}\n  - sukunimi : String {encrypted}\n  - katuosoite : String {encrypted}\n  - postinumero : String {encrypted}\n  - postitoimipaikka : String {encrypted}\n  + haeYhteystiedot() : String\n}\n\nclass Matkakohde &lt;&lt;Entity&gt;&gt; {\n  - kohdeId : UUID &lt;&lt;PK&gt;&gt;\n  - nimi : String\n  - maa : String\n  - esittelyteksti : Text\n  - kuvaUrlLista : List&lt;String&gt;\n  - aktiivinen : Boolean\n  + haeAktiivisetLahdot() : List&lt;Lahto&gt;\n}\n\nclass Hotelli &lt;&lt;Entity&gt;&gt; {\n  - hotelliId : UUID &lt;&lt;PK&gt;&gt;\n  - kohdeId : UUID &lt;&lt;FK&gt;&gt;\n  - nimi : String\n  - katuosoite : String\n  - esittely : Text\n  + haeHuonetyypit() : List&lt;Huonetyyppi&gt;\n}\n\nclass Huonetyyppi &lt;&lt;Entity&gt;&gt; {\n  - huonetyyppiId : UUID &lt;&lt;PK&gt;&gt;\n  - hotelliId : UUID &lt;&lt;FK&gt;&gt;\n  - nimike : String\n  - perushenkilomaara : Integer\n  - viikkohintaSisLennot : Decimal\n  + laskeHinta(viikot : Integer) : Decimal\n}\n\nclass Lahto &lt;&lt;Entity&gt;&gt; {\n  - lahtoId : UUID &lt;&lt;PK&gt;&gt;\n  - kohdeId : UUID &lt;&lt;FK&gt;&gt;\n  - lahtopaiva : Date\n  - paluulentoKapasiteetti : Integer\n  - lennonTunnus : String\n}\n\nclass LahtoHuonetyyppi &lt;&lt;Entity&gt;&gt; {\n  - kapasiteettiId : UUID &lt;&lt;PK&gt;&gt;\n  - lahtoId : UUID &lt;&lt;FK&gt;&gt;\n  - huonetyyppiId : UUID &lt;&lt;FK&gt;&gt;\n  - kiintioKoko : Integer\n  - vapaatPaikat : Integer {&gt;= 0}\n  + varaaPaikka(maara : Integer) : Boolean\n  + vapautaPaikka(maara : Integer) : void\n}\n\nclass Varaus &lt;&lt;Entity&gt;&gt; {\n  - varausId : UUID &lt;&lt;PK&gt;&gt;\n  - varausnumero : String {unique}\n  - asiakasId : UUID &lt;&lt;FK&gt;&gt;\n  - kapasiteettiId : UUID &lt;&lt;FK&gt;&gt;\n  - kestoViikkoina : Integer {1..4}\n  - kokonaishinta : Decimal\n  - tila : VarauksenTila\n  - luontiAika : DateTime\n  + vahvistaVaraus() : void\n  + onkoKokonaanMaksettu() : Boolean\n}\n\nclass Maksu &lt;&lt;Entity&gt;&gt; {\n  - maksuId : UUID &lt;&lt;PK&gt;&gt;\n  - varausId : UUID &lt;&lt;FK&gt;&gt;\n  - maksunTyyppi : MaksunTyyppi\n  - summa : Decimal\n  - tila : MaksunTila\n  - maksupalveluViite : String\n  - aikaleima : DateTime\n  + kuittaaSuoritus() : Boolean\n}\n\nclass Matkalippu &lt;&lt;Entity&gt;&gt; {\n  - lippuId : UUID &lt;&lt;PK&gt;&gt;\n  - varausId : UUID &lt;&lt;FK&gt;&gt;\n  - lippuNumero : String {unique}\n  - luontiAika : DateTime\n  - pdfPolku : String\n  - luovutettu : Boolean\n  + generoiJaAvaaLippu() : File\n}\n\n&#39; Relaatiot ja kardinaalisuudet (UML 2.0)\nKayttaja \&quot;0..1\&quot; -- \&quot;1\&quot; Asiakas : tunnistautuu &gt;\nAsiakas \&quot;1\&quot; -- \&quot;0..*\&quot; Varaus : tekee &gt;\n\nMatkakohde \&quot;1\&quot; *-- \&quot;1..*\&quot; Hotelli : sisältää &gt;\nHotelli \&quot;1\&quot; *-- \&quot;1..*\&quot; Huonetyyppi : tarjoaa &gt;\nMatkakohde \&quot;1\&quot; *-- \&quot;0..*\&quot; Lahto : järjestää &gt;\n\nLahto \&quot;1\&quot; -- \&quot;1..*\&quot; LahtoHuonetyyppi : määrittää saatavuuden &gt;\nHuonetyyppi \&quot;1\&quot; -- \&quot;0..*\&quot; LahtoHuonetyyppi : kuuluu kiintiöön &gt;\n\nLahtoHuonetyyppi \&quot;1\&quot; -- \&quot;0..*\&quot; Varaus : kohdistuu &gt;\nVaraus \&quot;1\&quot; *-- \&quot;1..2\&quot; Maksu : sisältää &gt;\nVaraus \&quot;1\&quot; -- \&quot;0..1\&quot; Matkalippu : oikeuttaa &gt;\n\n&#39; Enum-kytkennät\nVaraus ..&gt; VarauksenTila\nMaksu ..&gt; MaksunTyyppi\nMaksu ..&gt; MaksunTila\nKayttaja ..&gt; KayttajaRooli\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="l6uQ3vo8rzSVAYfJ3sOk-1">
